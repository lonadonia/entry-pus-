# ── Flask ─────────────────────────────────────────────────────────────────────
SECRET_KEY=replace-with-a-long-random-string   # Used to sign sessions and cookies

# Single admin operator login. CHANGE THESE in production — config.py ships weak
# defaults (admin / a hardcoded password) used only when these are unset.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# ── PostgreSQL (used by docker-compose postgres service AND DATABASE_URL) ──────
POSTGRES_DB=contestbot
POSTGRES_USER=contestbot
POSTGRES_PASSWORD=contestbot

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://contestbot:contestbot@postgres:5432/contestbot   # SQLAlchemy connection string

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0   # General Redis connection (SocketIO, caching)

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0       # Message broker for task queue
CELERY_RESULT_BACKEND=redis://redis:6379/1   # Where task results are stored

# ── AI / Image APIs ───────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...            # OpenAI key — used for GPT-4o contest analysis
KIE_API_KEY=your-kie-key-here   # kie.ai key — used for GPT-Image-2 generation
IMGBB_API_KEY=                  # imgbb.com key — only needed when image_host_method=imgbb

# ── Server ────────────────────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0   # Host Flask binds to inside the container
FLASK_ENV=production  # Set to "development" for debug mode + auto-reload

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_PATH=storage/designs   # Root dir for contest attachments and generated images
